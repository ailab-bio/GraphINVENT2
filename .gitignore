# Ignore the QSAR model to be used for fine-tuning in RL jobs
data/fine-tuning/qsar_model.pickle

# Ignore the Docker container
docker/graphinvent.sif

# Ignore all VSCode and Claude Code files in the entire project
.vscode/*
.claude/*
TODO.md
CHANGES.md
manuscript/*

# Ignore raw third-party database downloads. TPDdb publishes no explicit
# redistribution licence, so the full tables are fetched at build time by
# src/graphinvent/tools/tpddb-create-dataset.py rather than vendored here; the
# small derived subset under data/datasets/ is kept, with its provenance.
data/raw/
# Derived files are rebuilt by the preprocessing scripts from the dated raw
# snapshot, so they are not committed either. The 1k development subset under
# data/datasets/zinc1k/ is the deliberate exception.
data/processed/

# Ignore all .h5 files in the entire project
*.h5
*.h5.chunked
_previous_run*/
train.csv

# Ignore CSV files in the data/pre-training/ directory
data/pre-training/*.csv

# Ignore everything a job writes; only config.yaml and experiment.yaml are kept
experiments/*/jobs/*/results/
experiments/*/jobs/*/checkpoints/
experiments/*/jobs/*/logs/
slurm*.out

# Ignore Python cache files and directories
**/__pycache__/
*.pyc
graphinvent2.egg-info/

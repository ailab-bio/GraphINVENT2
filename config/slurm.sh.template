#!/bin/bash -l
#SBATCH -A {account}
#SBATCH -p {partition}
#SBATCH -J {job_name}
#SBATCH -t {time}
#SBATCH -n {ntasks}
#SBATCH -c {cpus_per_task}
{resources}#SBATCH -o {logs_dir}slurm-%j.out
#SBATCH -e {logs_dir}slurm-%j.err

set -euo pipefail

# Lmod defines `module` as a shell function, and a non-interactive shell that
# never sourced the profile does not have it. Without this check a missing
# Lmod surfaces three steps later as a missing shared library, which reads
# like a build problem rather than a login-shell problem. `#!/bin/bash -l`
# above is the mitigation; this is the assertion that it worked.
if [ -n "{modules}" ] && ! command -v module >/dev/null 2>&1 \
        && ! declare -F module >/dev/null 2>&1; then
    echo "FATAL: this job asks for module loads and \`module\` is not defined." >&2
    echo "Lmod provides it as a shell function, so a non-login shell does not" >&2
    echo "have it. Check that the script runs under 'bash -l' and that the" >&2
    echo "cluster's profile is readable from a compute node." >&2
    exit 1
fi

{modules}
export MPLBACKEND=Agg
export QT_QPA_PLATFORM=offscreen

# Thread counts, from slurm.cpus_per_task rather than hard-coded. Left unset,
# the OpenMP runtimes behind torch, numpy and RDKit size their pools from the
# node's core count, not from the cpuset this job was given: on a 256-core node
# that is ~256 threads fighting over the cores actually allocated, which is
# both antisocial on a shared node and slower than the correct count. PyTorch
# takes its intra-op thread count from OMP_NUM_THREADS, so this needs no code.
export OMP_NUM_THREADS={cpus_per_task}
export MKL_NUM_THREADS={cpus_per_task}
export OPENBLAS_NUM_THREADS={cpus_per_task}

cd {repo_root}
srun {python} submit.py {job_dir}

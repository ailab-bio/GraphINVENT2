#!/bin/bash
#SBATCH -A {account}
#SBATCH -p {partition}
#SBATCH -J {job_name}
#SBATCH -t {time}
#SBATCH -n {ntasks}
#SBATCH -c {cpus_per_task}
{resources}#SBATCH -o {logs_dir}slurm-%j.out
#SBATCH -e {logs_dir}slurm-%j.err

set -euo pipefail

{modules}
export MPLBACKEND=Agg
export QT_QPA_PLATFORM=offscreen

cd {repo_root}
srun {python} submit.py {job_dir}
